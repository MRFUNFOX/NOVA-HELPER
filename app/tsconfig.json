{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["svelte", "vite/client"],
    "paths": { "@shared/*": ["../parser/src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
