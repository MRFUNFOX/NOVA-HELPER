{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA HELPER",
  "version": "0.4.1",
  "identifier": "ru.novahelper.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NOVA HELPER",
        "url": "index.html",
        "width": 560,
        "height": 760,
        "minWidth": 380,
        "minHeight": 440,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "center": false,
        "shadow": true
      },
      {
        "label": "hint",
        "title": "NOVA HELPER — подсказка",
        "url": "hint.html",
        "width": 300,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "NOVA HELPER",
    "shortDescription": "Правила NOVA RP поверх игры",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNjFGQTk4MDU4MkYxNUEKUldSYThZSUZtUHBoYTBzSjFudmFDRG9lMzRROUlTeXQ3c3ZqUHJrS0hRWnh0QzVpZWpFdGZkZ0MK",
      "endpoints": [
        "https://github.com/MRFUNFOX/NOVA-HELPER/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
